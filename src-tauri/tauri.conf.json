{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "吉行影记",
  "version": "0.8.5",
  "identifier": "com.leishuo.galaxyrecorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "吉行影记",
        "width": 1240,
        "height": 850,
        "minWidth": 360,
        "minHeight": 640,
        "backgroundColor": "#f5f7fc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
